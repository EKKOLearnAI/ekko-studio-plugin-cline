{
  "schemaVersion": 1,
  "description": "Cline implements Studio Agent API v1 for global and scoped single chat. Host requests, outputs and identity are defined in sdk/src/agents.ts. Native model choices and approvals are ACP session state.",
  "models": {
    "empty": {
      "type": "null",
      "description": "Omit the request input to receive the current command."
    },
    "loginCommand": {
      "type": "object",
      "description": "Interactive native login command for the activating Studio account and Profile.",
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell-quoted Cline auth invocation. Empty if the engine is not installed.",
          "maxLength": 16384
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "ack": {
      "type": "object",
      "description": "Successful mutation.",
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "True after the write completes.",
          "enum": [
            true
          ]
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "description": "Select a native Skill.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Native skill directory or MCP server name.",
          "maxLength": 128
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "resourceRevision": {
      "type": "object",
      "description": "Remove a single resource after checking its revision.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Native skill directory or MCP server name.",
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "revision"
      ],
      "additionalProperties": false
    },
    "skillList": {
      "type": "object",
      "description": "User-level MiniMax Code Skills.",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Absolute native Skill root.",
          "maxLength": 4096
        },
        "items": {
          "type": "array",
          "description": "Skill summaries.",
          "items": {
            "type": "object",
            "description": "Skill file summary.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Native skill directory or MCP server name.",
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "description": "Skill frontmatter description.",
                "maxLength": 2000
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether MiniMax Code should discover this resource."
              },
              "readOnly": {
                "type": "boolean",
                "description": "Linked or conflicting Skill files cannot be edited."
              }
            },
            "required": [
              "name",
              "description",
              "enabled",
              "readOnly"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "directory",
        "items"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "description": "Editable or new native Skill document.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Native skill directory or MCP server name.",
          "maxLength": 128
        },
        "markdown": {
          "type": "string",
          "description": "Complete SKILL.md, including its native YAML frontmatter.",
          "maxLength": 1048576
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether MiniMax Code should discover this resource."
        },
        "revision": {
          "type": "string",
          "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "markdown",
        "enabled",
        "revision"
      ],
      "additionalProperties": false
    },
    "skillEditor": {
      "type": "object",
      "description": "Edit the Markdown body and description of a native Skill with revision protection.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Native skill directory or MCP server name.",
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether MiniMax Code should discover this resource."
        },
        "description": {
          "type": "string",
          "description": "Native description field.",
          "maxLength": 2000
        },
        "content": {
          "type": "string",
          "description": "Skill Markdown body.",
          "maxLength": 200000
        }
      },
      "required": [
        "name",
        "revision",
        "enabled",
        "description",
        "content"
      ],
      "additionalProperties": false
    },
    "mcpServer": {
      "type": "object",
      "description": "One user-level native MCP server.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Native skill directory or MCP server name.",
          "maxLength": 128
        },
        "config": {
          "type": "object",
          "description": "Native MCP server configuration; unknown JSON fields are preserved.",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether MiniMax Code should discover this resource."
        },
        "revision": {
          "type": "string",
          "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
          "maxLength": 64
        }
      },
      "required": [
        "name",
        "config",
        "enabled",
        "revision"
      ],
      "additionalProperties": false
    },
    "mcpList": {
      "type": "object",
      "description": "User-level native MCP configuration with credentials masked.",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path to cline_mcp_settings.json.",
          "maxLength": 4096
        },
        "items": {
          "type": "array",
          "description": "MCP entries.",
          "items": {
            "type": "object",
            "description": "Native MCP entry with masked credentials.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Native skill directory or MCP server name.",
                "maxLength": 128
              },
              "config": {
                "type": "object",
                "description": "Native MCP server configuration; unknown JSON fields are preserved.",
                "properties": {},
                "required": [],
                "additionalProperties": true
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether MiniMax Code should discover this resource."
              },
              "revision": {
                "type": "string",
                "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
                "maxLength": 64
              }
            },
            "required": [
              "name",
              "config",
              "enabled",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "path",
        "items"
      ],
      "additionalProperties": false
    },
    "settingsRequest": {
      "type": "object",
      "description": "Request with no parameters.",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "settingsEditor": {
      "type": "object",
      "description": "Native settings with provider credentials masked and the active CLI status.",
      "properties": {
        "revision": {
          "type": "string",
          "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
          "maxLength": 64
        },
        "models": {
          "type": "object",
          "description": "Native Cline providers.json with masked credentials.",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "config": {
          "type": "object",
          "description": "Native Cline globalState.json with masked credentials.",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "path": {
          "type": "string",
          "description": "Absolute path to globalState.json.",
          "maxLength": 4096
        },
        "loginCommand": {
          "type": "string",
          "description": "Shell command to sign in on the Studio host through the selected CLI. Empty when an engine is unavailable.",
          "maxLength": 16384
        },
        "status": {
          "type": "object",
          "description": "CLI installation status.",
          "properties": {
            "installed": {
              "type": "boolean",
              "description": "Whether the CLI is installed."
            },
            "version": {
              "type": "string",
              "description": "Detected CLI version.",
              "maxLength": 128
            },
            "source": {
              "type": "string",
              "description": "CLI installation source.",
              "maxLength": 128
            },
            "error": {
              "type": "string",
              "description": "Actionable status error.",
              "maxLength": 1024
            }
          },
          "required": [
            "installed",
            "version"
          ],
          "additionalProperties": false
        },
        "providersPath": {
          "type": "string",
          "description": "Absolute path to providers.json.",
          "maxLength": 4096
        }
      },
      "required": [
        "revision",
        "models",
        "config",
        "path",
        "providersPath",
        "loginCommand",
        "status"
      ],
      "additionalProperties": false
    },
    "settingsEditorWrite": {
      "type": "object",
      "description": "Update both Cline native settings documents at their current revision.",
      "properties": {
        "revision": {
          "type": "string",
          "description": "Opaque SHA-256 of the last read item; empty for new items or missing entries.",
          "maxLength": 64
        },
        "models": {
          "type": "object",
          "description": "Native Cline providers.json with masked credentials.",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "config": {
          "type": "object",
          "description": "Native Cline globalState.json with masked credentials.",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "revision",
        "models",
        "config"
      ],
      "additionalProperties": false
    }
  },
  "rpc": {
    "native-login": {
      "description": "Read the command for the selected external or Studio-managed native Cline engine. Returns no credentials.",
      "input": "empty",
      "output": "loginCommand"
    },
    "list-skills": {
      "input": "settingsRequest",
      "output": "skillList",
      "description": "List native user-level Skills."
    },
    "get-skill": {
      "input": "name",
      "output": "skill",
      "description": "Load one Skill for editing."
    },
    "save-skill": {
      "input": "skill",
      "output": "ack",
      "description": "Create, edit, enable or disable an editable Skill."
    },
    "edit-skill": {
      "description": "Save separate Skill description and Markdown fields while retaining other frontmatter.",
      "input": "skillEditor",
      "output": "ack"
    },
    "remove-skill": {
      "input": "resourceRevision",
      "output": "ack",
      "description": "Remove the Skill document while preserving companion files."
    },
    "list-mcp": {
      "input": "settingsRequest",
      "output": "mcpList",
      "description": "List native user-level MCP servers with credentials masked."
    },
    "save-mcp": {
      "input": "mcpServer",
      "output": "ack",
      "description": "Save one MCP server and merge masked values from its last revision."
    },
    "remove-mcp": {
      "input": "resourceRevision",
      "output": "ack",
      "description": "Remove one native MCP server."
    },
    "get-settings-editor": {
      "description": "Read the editable native configuration and current CLI status.",
      "input": "settingsRequest",
      "output": "settingsEditor"
    },
    "save-settings-editor": {
      "description": "Update model and runtime sections of the native configuration.",
      "input": "settingsEditorWrite",
      "output": "ack"
    }
  },
  "storage": {},
  "tools": {},
  "commands": {},
  "actions": {},
  "events": {},
  "checkpoints": {}
}
